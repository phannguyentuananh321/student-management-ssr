<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý sinh viên</title>
  <!-- Bootstrap 5 CSS CDN để tối ưu hóa code và responsive hiện đại -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <!-- GSAP CDN -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
</head>
<body class="bg-light py-4">
  <div class="container main-container">
    <!-- Tiêu đề -->
    <header class="text-center mb-4 app-header">
      <h1 class="fw-bold text-primary">Quản lý sinh viên</h1>
      <p class="text-muted">Hệ thống quản lý thông tin và danh sách sinh viên</p>
    </header>

    <!-- Khu vực thông báo thành công hoặc lỗi -->
    <div class="alerts-container mb-4">
      <% if (successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
          <strong>Thành công!</strong> <%= successMessage %>
        </div>
      <% } %>
      <% if (errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
          <strong>Thông báo:</strong> <%= errorMessage %>
        </div>
      <% } %>
    </div>

    <!-- Form tạo sinh viên -->
    <div class="card shadow-sm mb-4 form-card">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="card-title mb-0 fw-semibold text-dark">Thêm sinh viên mới</h5>
      </div>
      <div class="card-body">
        <form action="/students" method="POST" id="createStudentForm" novalidate>
          <div class="row g-3">
            <!-- Họ và tên -->
            <div class="col-md-6">
              <label for="name" class="form-label">Họ và tên <span class="text-danger">*</span></label>
              <input 
                type="text" 
                class="form-control <%= errors && errors.name ? 'is-invalid' : '' %>" 
                id="name" 
                name="name" 
                placeholder="Ví dụ: Nguyễn Văn An"
                value="<%= (formData && formData.name) ? formData.name : '' %>"
                <% if (errors && errors.name) { %>aria-invalid="true" aria-describedby="name-error"<% } %>
              >
              <% if (errors && errors.name) { %>
                <div class="invalid-feedback d-block" id="name-error"><%= errors.name %></div>
              <% } %>
            </div>

            <!-- Email -->
            <div class="col-md-6">
              <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
              <input 
                type="text" 
                class="form-control <%= errors && errors.email ? 'is-invalid' : '' %>" 
                id="email" 
                name="email" 
                placeholder="Ví dụ: student@example.com"
                value="<%= (formData && formData.email) ? formData.email : '' %>"
                <% if (errors && errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>
              >
              <% if (errors && errors.email) { %>
                <div class="invalid-feedback d-block" id="email-error"><%= errors.email %></div>
              <% } %>
            </div>

            <!-- Ngày sinh -->
            <div class="col-md-6">
              <label for="dateOfBirth" class="form-label">Ngày sinh <span class="text-danger">*</span></label>
              <input 
                type="date" 
                class="form-control <%= errors && errors.dateOfBirth ? 'is-invalid' : '' %>" 
                id="dateOfBirth" 
                name="dateOfBirth"
                value="<%= (formData && formData.dateOfBirth) ? formData.dateOfBirth : '' %>"
                <% if (errors && errors.dateOfBirth) { %>aria-invalid="true" aria-describedby="dob-error"<% } %>
              >
              <% if (errors && errors.dateOfBirth) { %>
                <div class="invalid-feedback d-block" id="dob-error"><%= errors.dateOfBirth %></div>
              <% } %>
            </div>

            <!-- Lớp -->
            <div class="col-md-6">
              <label for="className" class="form-label">Lớp <span class="text-danger">*</span></label>
              <input 
                type="text" 
                class="form-control <%= errors && errors.className ? 'is-invalid' : '' %>" 
                id="className" 
                name="className" 
                placeholder="Ví dụ: SE1"
                value="<%= (formData && formData.className) ? formData.className : '' %>"
                <% if (errors && errors.className) { %>aria-invalid="true" aria-describedby="className-error"<% } %>
              >
              <% if (errors && errors.className) { %>
                <div class="invalid-feedback d-block" id="className-error"><%= errors.className %></div>
              <% } %>
            </div>

            <div class="col-12 mt-4 text-end">
              <button type="submit" class="btn btn-primary px-4 fw-medium btn-create">Thêm sinh viên</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Khu vực lọc theo lớp & Đếm số lượng -->
    <div class="card shadow-sm mb-4 filter-card">
      <div class="card-body py-3">
        <form action="/students" method="GET" class="row align-items-center g-3">
          <div class="col-auto">
            <label for="filterClass" class="col-form-label fw-medium">Lọc theo lớp:</label>
          </div>
          <div class="col-sm-4 col-md-3">
            <select name="className" id="filterClass" class="form-select">
              <option value="">Tất cả các lớp</option>
              <% allClasses.forEach(function(cls) { %>
                <option value="<%= cls %>" <%= (selectedClass && selectedClass.toLowerCase() === cls.toLowerCase()) ? 'selected' : '' %>>
                  <%= cls %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Lọc</button>
            <a href="/students" class="btn btn-outline-secondary">Đặt lại</a>
          </div>
          <div class="col-12 col-md text-md-end mt-2 mt-md-0">
            <span class="badge bg-secondary-subtle text-secondary-emphasis fs-6 px-3 py-2 count-badge">
              <% if (selectedClass) { %>
                <% if (displayCount > 0) { %>
                  Tìm thấy <%= displayCount %> sinh viên thuộc lớp <%= selectedClass %>.
                <% } else { %>
                  Không có sinh viên thuộc lớp này.
                <% } %>
              <% } else { %>
                Đang hiển thị <%= displayCount %> sinh viên.
              <% } %>
            </span>
          </div>
        </form>
      </div>
    </div>

    <!-- Bảng danh sách sinh viên -->
    <div class="card shadow-sm table-card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="py-3 px-3">ID</th>
                <th scope="col" class="py-3">Họ và tên</th>
                <th scope="col" class="py-3">Email</th>
                <th scope="col" class="py-3">Ngày sinh</th>
                <th scope="col" class="py-3 px-3">Lớp</th>
              </tr>
            </thead>
            <tbody id="studentTableBody">
              <% if (students && students.length > 0) { %>
                <% students.forEach(function(student) { %>
                  <tr>
                    <td class="px-3 text-muted"><%= student.id %></td>
                    <td class="fw-medium text-dark"><%= student.name %></td>
                    <td><%= student.email %></td>
                    <td><%= student.dateOfBirth %></td>
                    <td class="px-3"><span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1"><%= student.className %></span></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-5 text-muted empty-state">
                    <% if (selectedClass) { %>
                      Không tìm thấy sinh viên nào thuộc lớp "<%= selectedClass %>".
                    <% } else { %>
                      Hiện chưa có sinh viên nào trong hệ thống.
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/script.js"></script>
</body>
</html>
